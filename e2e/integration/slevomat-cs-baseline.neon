parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property PHPStan\\PhpDocParser\\Ast\\Type\\IdentifierTypeNode\|PHPStan\\PhpDocParser\\Ast\\Type\\NameNode\:\:\$name\.$#'
			identifier: property.notFound
			count: 2
			path: repo/SlevomatCodingStandard/Helpers/AnnotationTypeHelper.php

		-
			message: '#^Parameter \#2 \$needle of static method SlevomatCodingStandard\\Helpers\\StringHelper\:\:startsWith\(\) expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: repo/SlevomatCodingStandard/Sniffs/Classes/ClassStructureSniff.php

		-
			message: '#^Property SlevomatCodingStandard\\Sniffs\\Commenting\\AnnotationNameSniff\:\:\$normalizedAnnotations \(array\<string, string\>\|null\) does not accept array\<string, string\>\|false\.$#'
			identifier: assign.propertyType
			count: 1
			path: repo/SlevomatCodingStandard/Sniffs/Commenting/AnnotationNameSniff.php

		-
			message: '#^Argument of an invalid type array\<int\<0, max\>, int\<0, max\>\>\|false supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: repo/SlevomatCodingStandard/Sniffs/Commenting/DocCommentSpacingSniff.php

		-
			message: '#^Access to an undefined property PHPStan\\PhpDocParser\\Ast\\Type\\IdentifierTypeNode\|PHPStan\\PhpDocParser\\Ast\\Type\\NameNode\:\:\$name\.$#'
			identifier: property.notFound
			count: 1
			path: repo/SlevomatCodingStandard/Sniffs/PHP/RequireExplicitAssertionSniff.php

		-
			message: '#^For loop initial assignment overwrites variable \$i\.$#'
			identifier: for.variableOverwrite
			count: 2
			path: repo/SlevomatCodingStandard/Sniffs/TypeHints/DeclareStrictTypesSniff.php

		-
			message: '#^Foreach overwrites \$typeNode with its value variable\.$#'
			identifier: foreach.valueOverwrite
			count: 1
			path: repo/SlevomatCodingStandard/Sniffs/TypeHints/NullTypeHintOnLastPositionSniff.php
