parameters:
	ignoreErrors:
		-
			message: '#^Call to method Doctrine\\ORM\\Mapping\\AssociationMapping\:\:isToOneOwningSide\(\) will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 1
			path: repo/src/Cache/DefaultEntityHydrator.php

		-
