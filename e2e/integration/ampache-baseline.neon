parameters:
	ignoreErrors:
		-
			message: '#^Strict comparison using \=\=\= between ''folder''\|''podcast_episode''\|''song''\|''video'' and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: repo/src/Module/Api/Json8_Data.php

		-
			message: '#^Strict comparison using \=\=\= between ''folder''\|''podcast_episode''\|''song''\|''video'' and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: repo/src/Module/Api/Xml8_Data.php

		-
			message: '#^Cannot call method send_command\(\) on AmpacheApi\\AmpacheApi\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: repo/src/Module/Catalog/Catalog_remote.php

		-
			message: '#^Instanceof between Ampache\\Module\\Catalog\\SubsonicClient and Ampache\\Module\\Catalog\\SubsonicClient will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 6
			path: repo/src/Module/Catalog/Catalog_subsonic.php

		-
			message: '#^Negated boolean expression is always true\.$#'
			identifier: booleanNot.alwaysTrue
			count: 1
			path: repo/src/Module/Catalog/Update/UpdateCatalog.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: repo/src/Module/Song/SongSorter.php

		-
			message: '#^Using nullsafe method call on non\-nullable type Ampache\\Module\\Catalog\\Catalog\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: repo/src/Module/Song/SongSorter.php

		-
			message: '#^Using nullsafe property access on non\-nullable type Ampache\\Module\\Catalog\\Catalog\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: repo/src/Module/Song/SongSorter.php

		-
			message: '#^Strict comparison using \!\=\= between non\-falsy\-string and ''0'' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: repo/src/Module/Application/Image/AbstractShowAction.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: repo/src/Module/Catalog/Catalog.php

		-
			message: '#^Strict comparison using \!\=\= between non\-falsy\-string and ''0'' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: repo/src/Module/Share/ShareUiLinkRenderer.php

		-
			message: '#^Comparison operation "\<" between int and int is always false\.$#'
			identifier: smaller.alwaysFalse
			count: 1
			path: repo/src/Module/Statistics/Stats.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: repo/src/Module/Statistics/Stats.php

		-
			message: '#^Strict comparison using \!\=\= between non\-falsy\-string and ''0'' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: repo/src/Module/Util/ZipHandler.php
