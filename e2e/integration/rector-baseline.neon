parameters:
	ignoreErrors:
		-
			message: '''
				#^Call to deprecated method toMutatingScope\(\) of interface PHPStan\\Analyser\\Scope\:
				The scope answers every ask directly \- call the methods on the scope itself, or toWalkScope\(\) for the engine\-facing walk scope\.$#
			'''
			identifier: method.deprecated
			count: 1
			path: repo/rules/Php81/NodeManipulator/NullToStrictStringIntConverter.php

		-
			message: '#^Call to method toMutatingScope\(\) on an unknown class PHPStan\\Analyser\\Fiber\\FiberScope\.$#'
			identifier: class.notFound
			count: 1
			path: repo/rules/Php81/NodeManipulator/NullToStrictStringIntConverter.php

		-
			message: '#^Class PHPStan\\Analyser\\Fiber\\FiberScope not found\.$#'
			identifier: class.notFound
			count: 1
			path: repo/rules/Php81/NodeManipulator/NullToStrictStringIntConverter.php

		-
			message: '#^Only abstract classes can be extended$#'
			identifier: symplify.forbiddenExtendOfNonAbstractClass
			count: 1
			path: repo/src/NodeTypeResolver/PHPStan/ObjectWithoutClassTypeWithParentTypes.php

		-
			message: '#^Call to deprecated method toMutatingScope\(\) of class PHPStan\\Analyser\\MutatingScope\.$#'
			identifier: method.deprecated
			count: 1
			path: repo/src/NodeTypeResolver/PHPStan/Scope/PHPStanNodeScopeResolver.php

