parameters:
	ignoreErrors:
		-
			rawMessage: Switch condition comparison between 'nullabletimestamps'|'nullabletimestampstz'|'remembertoken'|'timestamps'|'timestampstz' and 'droptimestamps' is always false.
			identifier: switch.alwaysFalse
			count: 1
			path: repo/src/Properties/SchemaAggregator.php

		-
			rawMessage: Switch condition comparison between 'nullabletimestamps'|'nullabletimestampstz'|'remembertoken'|'timestamps'|'timestampstz' and 'droptimestampstz' is always false.
			identifier: switch.alwaysFalse
			count: 1
			path: repo/src/Properties/SchemaAggregator.php

		-
			rawMessage: Switch condition comparison between 'nullabletimestamps'|'nullabletimestampstz'|'timestamps'|'timestampstz' and 'dropremembertoken' is always false.
			identifier: switch.alwaysFalse
			count: 1
			path: repo/src/Properties/SchemaAggregator.php

		-
			rawMessage: Value assigned to variable $firstMethodCall is never read.
			identifier: assign.unused
			count: 1
			path: repo/src/Properties/SchemaAggregator.php

		-
			rawMessage: 'Strict comparison using !== between PhpParser\Node\Expr and null will always evaluate to true.'
