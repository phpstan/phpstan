# Flow 9.3 removed phpstan-legacy.neon.dist, which linted these packages at level 3,
# and no longer analyses them (Neos.Flow/Classes moved to level 8 in phpstan.neon.dist).
# This keeps the remaining packages of that configuration covered.
includes:
	- flow-legacy-baseline.neon

parameters:
	level: 3
	paths:
		- flow-dist/Packages/Framework/Neos.Cache/Classes
		- flow-dist/Packages/Framework/Neos.Eel/Classes
		- flow-dist/Packages/Framework/Neos.Error.Messages/Classes
	bootstrapFiles:
		- flow-dist/Packages/Framework/bootstrap-phpstan.php
	excludePaths:
		analyse:
			# The parsers are autogenerated / extending autogenerated code and not analysable
			- flow-dist/Packages/Framework/Neos.Eel/Classes/FlowQuery/FizzleParser.php
			- flow-dist/Packages/Framework/Neos.Eel/Classes/AbstractParser.php
			- flow-dist/Packages/Framework/Neos.Eel/Classes/EelParser.php
			- flow-dist/Packages/Framework/Neos.Eel/Classes/InterpretedEelParser.php
			- flow-dist/Packages/Framework/Neos.Eel/Classes/CompilingEelParser.php
	reportUnmatchedIgnoredErrors: false
