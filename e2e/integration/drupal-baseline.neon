			path: repo/core/modules/filter/src/FilterProcessResult.php

		-
			message: '#^Method Drupal\\taxonomy\\Plugin\\views\\argument_default\\Tid\:\:getCacheTags\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
