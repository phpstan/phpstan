			identifier: missingType.return
			count: 1
			path: repo/core/modules/taxonomy/src/TermForm.php

		-
			message: '#^Variable \$untranslatable_configs in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
