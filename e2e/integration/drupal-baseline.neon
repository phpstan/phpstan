parameters:
	ignoreErrors:
		-
			message: '#^Variable \$relationship_specifier on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: repo/core/lib/Drupal/Core/Entity/Query/Sql/Tables.php

		-
			message: '#^Property Drupal\\Core\\File\\MimeType\\MimeTypeMap\:\:\$mapping \(array\{mimetypes\: array\{int, string\}, extensions\: array\{string, int\}\}\) does not accept array\{mimetypes\: array\{\}, extensions\: array\{string, int\}\}\.$#'
			identifier: assign.propertyType
			count: 1
			path: repo/core/lib/Drupal/Core/File/MimeType/MimeTypeMap.php

		-
			message: '#^Parameter &\$sanitized_keys by\-ref type of method Drupal\\Core\\Security\\RequestSanitizer\:\:stripDangerousValues\(\) expects array\<string\>, array\<\(int\|string\)\> given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: repo/core/lib/Drupal/Core/Security/RequestSanitizer.php

		-
			message: '#^Access to an undefined property Drupal\\Core\\Entity\\EntityInterface\:\:\$weight\.$#'
			identifier: property.notFound
			count: 1
			path: repo/core/modules/user/src/Entity/Role.php

		-
			message: '#^Method Drupal\\Core\\Update\\DatabaseUpdate\:\:systemSchemaRequirements\(\) should return array\<string, array\{title\: Drupal\\Core\\StringTranslation\\TranslatableMarkup, value\: mixed, description\: Drupal\\Core\\StringTranslation\\TranslatableMarkup, severity\: Drupal\\Core\\Extension\\Requirement\\RequirementSeverity\}\> but returns array\{''minimum schema''\: array\{value\: ''The installed…'', description\: non\-falsy\-string, title\: ''Minimum schema…''\}\|array\{value\: ''The installed…'', severity\: Drupal\\Core\\Extension\\Requirement\\RequirementSeverity\:\:Error, description\: non\-falsy\-string, title\: ''Minimum schema…''\}\}\.$#'
			identifier: return.type
			count: 1
			path: repo/core/lib/Drupal/Core/Update/DatabaseUpdate.php

		-
			message: '#^Method Drupal\\Tests\\content_moderation\\Functional\\ViewsModerationStateFilterTest\:\:providerTestWorkflowChanges\(\) should return array\<string\> but returns array\<string, array\<int, string\>\>\.$#'
			identifier: return.type
			count: 1
			path: repo/core/modules/content_moderation/tests/src/Functional/ViewsModerationStateFilterTest.php

		-
			message: '#^Method Drupal\\jsonapi\\Context\\FieldResolver\:\:getFieldItemDefinitions\(\) should return array\<Drupal\\Core\\TypedData\\ComplexDataDefinitionInterface\> but returns array\<string, Drupal\\Core\\TypedData\\DataDefinitionInterface\>\.$#'
			identifier: return.type
			count: 1
			path: repo/core/modules/jsonapi/src/Context/FieldResolver.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(Drupal\\Core\\TypedData\\ComplexDataDefinitionInterface\)\: mixed\)\|null, Closure\(Drupal\\Core\\Field\\TypedData\\FieldItemDataDefinitionInterface\)\: list\<int\|string\> given\.$#'
			identifier: argument.type
			count: 1
			path: repo/core/modules/jsonapi/src/Context/FieldResolver.php
