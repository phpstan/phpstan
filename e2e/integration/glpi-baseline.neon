parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$event of static method Reservation\:\:updateEvent\(\) expects array\{id\: int, start\: string, end\: string\}, non\-empty\-array\<mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: repo/ajax/reservations.php

		-
			message: '#^Parameter \#1 \.\.\.\$arg1 of function max expects non\-empty\-array, list given\.$#'
			identifier: argument.type
			count: 3
			path: repo/install/empty_data.php

		-
			message: '#^Method CommonDevice\:\:getMenuContent\(\) should return array\<string, array\<string, array\<string, array\{search\: string, add\?\: string, template\?\: string\}\|array\{title\: string, page\: string, icon\?\: string, links\?\: array\{search\: string, add\?\: string, template\?\: string\}\}\|string\>\|string\>\|string\|true\>\|false but returns array\{title\: string, page\: ''/front/devices\.php'', icon\: string, options\?\: non\-empty\-array\<class\-string, array\{title\: mixed, page\: string, icon\: string, links\: non\-empty\-array\<non\-falsy\-string, string\>\}\>\}\.$#'
			identifier: return.type
			count: 1
			path: repo/src/CommonDevice.php

		-
			message: '#^Parameter \#1 \$input of method CommonITILObject\:\:isTakeIntoAccountComputationBlocked\(\) expects array, array\<string, mixed\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: repo/src/CommonITILActor.php

		-
			message: '#^Offset ''periodicity''\|''periodicitynotice'' might not exist on non\-empty\-array\{periodicity\?\: non\-falsy\-string, periodicitynotice\?\: non\-falsy\-string\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: repo/src/Contract.php

		-
			message: '#^Property DBmysql\:\:\$dbh in isset\(\) is not nullable nor uninitialized\.$#'
			identifier: isset.initializedProperty
			count: 1
			path: repo/src/DBmysql.php

		-
			message: '#^Method Glpi\\Api\\HL\\OpenAPIGenerator\:\:getPathSchemas\(\) should return array\<string, array\<string, array\{tags\: array\<string\>, responses\: array\<int\|string, array\{description\: string\}\>, description\?\: string, parameters\: array\<array\{''\$ref''\: string\}\|array\{name\: string, in\: string, description\: string, required\: bool, schema\: mixed\}\>, requestBody\?\: array\{content\: array\{''application/json''\: array\{schema\: array\{type\: string, format\?\: string, pattern\?\: string, properties\?\: array\<string, array\{type\: string, format\?\: string\}\>\}\}\}\}\}\>\> but returns non\-empty\-array\<string, array\<string, array\{tags\: array\<string\>, responses\: array, description\?\: string, parameters\: non\-empty\-list\<array\{name\: string, in\: string, description\: string, required\?\: bool, schema\: mixed, ''\$ref''\?\: string, default\?\: false, examples\: array\{English_GB\: array\{value\: ''en_GB'', summary\: ''English \(United…''\}, French_FR\: array\{value\: ''fr_FR'', summary\: ''French \(France\)''\}, Portuguese_BR\: array\{value\: ''pt_BR'', summary\: ''Portuguese \(Brazil\)''\}\}\}\>, requestBody\?\: array\{content\: array\{''application/json''\: array\{schema\: array\{type\: string, format\?\: string, pattern\?\: string, properties\?\: array\<string, array\{type\: string, format\?\: string\}\>\}\}\}\}, security\: array\<array\<string, array\<string, mixed\>\>\>, x\-controller\: string\}\>\>\.$#'
			identifier: return.type
			count: 1
			path: repo/src/Glpi/Api/HL/OpenAPIGenerator.php

		-
			message: '#^Instanceof between DBmysql and DBmysql will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: repo/src/Glpi/Console/Application.php

		-
			message: '#^Property Glpi\\Debug\\ProfilerSection\:\:\$pauses \(array\<array\{start\: int, end\?\: int\}\>\) does not accept non\-empty\-array\<array\{start\: float\<0\.0, max\>\}\|array\{start\: int, end\?\: int\}\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: repo/src/Glpi/Debug/ProfilerSection.php

		-
			message: '#^Property Glpi\\Debug\\ProfilerSection\:\:\$pauses \(array\<array\{start\: int, end\?\: int\}\>\) does not accept non\-empty\-array\<array\{start\: int, end\?\: float\<0\.0, max\>\|int\}\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: repo/src/Glpi/Debug/ProfilerSection.php

		-
			message: '#^Access to an undefined property object\:\:\$name\.$#'
			identifier: property.notFound
			count: 1
			path: repo/src/Glpi/Inventory/Asset/Monitor.php

		-
			message: '#^Loose comparison using \!\= between array\{mixed\} and '''' will always evaluate to true\.$#'
			identifier: notEqual.alwaysTrue
			count: 2
			path: repo/src/Glpi/Inventory/Asset/VirtualMachine.php

		-
			message: '#^Loose comparison using \!\= between float\|int\|numeric\-string and ''NULL'' will always evaluate to true\.$#'
			identifier: notEqual.alwaysTrue
			count: 1
			path: repo/src/Glpi/Search/Provider/SQLProvider.php

		-
			message: '#^Loose comparison using \!\= between float\|int\|numeric\-string and ''null'' will always evaluate to true\.$#'
			identifier: notEqual.alwaysTrue
			count: 1
			path: repo/src/Glpi/Search/Provider/SQLProvider.php

		-
			message: '#^Parameter \#1 \$size of static method Toolbox\:\:getSize\(\) expects int, int\<min, \-2\>\|int\<0, max\>\|string given\.$#'
			identifier: argument.type
			count: 1
			path: repo/src/Glpi/System/Requirement/MemoryLimit.php

		-
			message: '#^Parameter \#2 \$times of function str_repeat expects int, float\|int\<0, max\> given\.$#'
			identifier: argument.type
			count: 1
			path: repo/src/IPNetmask.php

		-
			message: '#^Binary operation "\+" between float\|int\|string\|null and float\<min, max\>\|int results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: repo/src/Infocom.php

		-
			message: '#^Property NotificationTarget\<Project\>\:\:\$data \(array\<string, array\<string\>\|string\>\) does not accept array\<string, array\<array\<string, string\>\|string\>\|string\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: repo/src/NotificationTargetProject.php

		-
			message: '#^Property NotificationTarget\<ProjectTask\>\:\:\$data \(array\<string, array\<string\>\|string\>\) does not accept array\<string, array\<array\<string, string\>\|string\>\|string\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: repo/src/NotificationTargetProjectTask.php

		-
			message: '#^Argument of an invalid type array\|null supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: repo/src/RuleImportAsset.php

		-
			message: '#^Parameter \#1 \$value of function count expects array\|Countable, array\|null given\.$#'
			identifier: argument.type
			count: 1
			path: repo/src/RuleImportAsset.php

		-
			message: '#^Cannot access offset ''id'' on array\<string, mixed\>\|false\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: repo/src/UserEmail.php
