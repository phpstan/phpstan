parameters:
	ignoreErrors:
		-
			message: '#^Foreach overwrites \$namespace with its key variable\.$#'
			identifier: foreach.keyOverwrite
			count: 1
			path: repo/src/bitExpert/PHPStan/Magento/Autoload/DataProvider/ClassLoaderProvider.php

		-
			message: '#^Foreach overwrites \$path with its value variable\.$#'
			identifier: foreach.valueOverwrite
			count: 1
			path: repo/src/bitExpert/PHPStan/Magento/Autoload/DataProvider/ClassLoaderProvider.php

		-
			message: '#^Parameter \#3 \$scope of method bitExpert\\PHPStan\\Magento\\Type\\ControllerResultFactoryReturnTypeExtension\:\:getTypeFromMethodCall\(\) expects PHPStan\\Analyser\\DependencyTracker&PHPStan\\Analyser\\Scope, PHPStan\\Analyser\\Scope&PHPUnit\\Framework\\MockObject\\MockObject given\.$#'
			identifier: argument.type
			count: 1
			path: repo/tests/bitExpert/PHPStan/Magento/Type/ControllerResultFactoryReturnTypeExtensionUnitTest.php
