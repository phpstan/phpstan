parameters:
	ignoreErrors:
		-
			message: '#^Foreach overwrites \$key with its value variable\.$#'
			identifier: foreach.valueOverwrite
			count: 1
			path: repo/build/remove-dead-translations.php

		-
			message: '#^Call to function is_infinite\(\) with float\<0\.0, 1\.0\> will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: repo/src/block/ItemFrame.php

		-
			message: '#^Casting to list\<string\> something that''s already list\<string\>\.$#'
			identifier: cast.useless
			count: 1
			path: repo/src/crash/CrashDump.php

		-
			message: '#^Offset 0\|1 might not exist on non\-empty\-array\{1\?\: \*NEVER\*, 0\?\: \*NEVER\*\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: repo/src/data/bedrock/item/ItemSerializerDeserializerRegistrar.php

		-
			message: '#^Offset 0\|1\|2\|3 might not exist on non\-empty\-array\{0\?\: non\-empty\-array\{1\?\: \*NEVER\*, 0\?\: \*NEVER\*\}, 1\?\: non\-empty\-array\{1\?\: \*NEVER\*, 0\?\: \*NEVER\*\}, 2\?\: non\-empty\-array\{1\?\: \*NEVER\*, 0\?\: \*NEVER\*\}, 3\?\: non\-empty\-array\{1\?\: \*NEVER\*, 0\?\: \*NEVER\*\}\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: repo/src/data/bedrock/item/ItemSerializerDeserializerRegistrar.php

		-
			message: '#^Foreach overwrites \$entity with its value variable\.$#'
			identifier: foreach.valueOverwrite
			count: 1
			path: repo/src/entity/object/AreaEffectCloud.php

		-
			message: '#^Parameter \#1 \$class of static method pocketmine\\event\\HandlerListManager\:\:isValidClass\(\) expects ReflectionClass\<pocketmine\\event\\Event\>, ReflectionClass\<TEvent of pocketmine\\event\\Event\> given\.$#'
			identifier: argument.type
			count: 1
			path: repo/src/event/HandlerListManager.php

		-
			message: '#^Cannot call method getPermissionRecalculationCallbacks\(\) on pocketmine\\player\\Player\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: repo/src/network/mcpe/NetworkSession.php

		-
			message: '#^Match arm comparison between 4 and 4 is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: repo/src/network/mcpe/handler/InGamePacketHandler.php

		-
			message: '#^Parameter \#1 \$list of method pocketmine\\thread\\ThreadSafeClassLoader\:\:appendOrPrependLookupEntry\(\) expects pmmp\\thread\\ThreadSafeArray\<int, string\>, pmmp\\thread\\ThreadSafeArray\<\(int\|string\), mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: repo/src/thread/ThreadSafeClassLoader.php

		-
			message: '#^pmmp\\thread\\ThreadSafeArray\<string, pmmp\\thread\\ThreadSafeArray\<int, string\>\> does not accept pmmp\\thread\\ThreadSafeArray\<\(int\|string\), mixed\>\.$#'
			identifier: offsetAssign.valueType
			count: 1
			path: repo/src/thread/ThreadSafeClassLoader.php

		-
			message: '#^Method pocketmine\\world\\World\:\:checkChunkPopulationPreconditions\(\) should return array\{pocketmine\\promise\\PromiseResolver\<pocketmine\\world\\format\\Chunk\>\|null, bool\} but returns array\{pocketmine\\promise\\PromiseResolver\<mixed\>, false\}\.$#'
			identifier: return.type
			count: 1
			path: repo/src/world/World.php

		-
			message: '#^Method pocketmine\\world\\World\:\:internalOrderChunkPopulation\(\) should return pocketmine\\promise\\Promise\<pocketmine\\world\\format\\Chunk\> but returns pocketmine\\promise\\Promise\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: repo/src/world/World.php

		-
			message: '#^Property pocketmine\\world\\World\:\:\$chunkPopulationRequestMap \(array\<int, pocketmine\\promise\\PromiseResolver\<pocketmine\\world\\format\\Chunk\>\>\) does not accept non\-empty\-array\<int, pocketmine\\promise\\PromiseResolver\<mixed\>\>\.$#'
			identifier: assign.propertyType
			count: 2
			path: repo/src/world/World.php

		-
			message: '#^Parameter \#2 \$length of function fread expects int\<1, max\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: repo/src/world/format/io/region/RegionLoader.php

		-
			message: '#^SplFixedArray\<SplFixedArray\<float\>\> does not accept SplFixedArray\<mixed\>\.$#'
			identifier: offsetAssign.valueType
			count: 2
			path: repo/src/world/generator/noise/Noise.php

		-
			message: '#^For loop initial assignment overwrites variable \$x\.$#'
			identifier: for.variableOverwrite
			count: 1
			path: repo/src/world/generator/normal/Normal.php

		-
			message: '#^Foreach overwrites \$newValue with its value variable\.$#'
			identifier: foreach.valueOverwrite
			count: 1
			path: repo/tools/blockstate-upgrade-schema-utils.php

		-
			message: '#^Foreach overwrites \$rawOldValue with its key variable\.$#'
			identifier: foreach.keyOverwrite
			count: 2
			path: repo/tools/blockstate-upgrade-schema-utils.php

		-
			message: '#^Foreach overwrites \$value with its key variable\.$#'
			identifier: foreach.keyOverwrite
			count: 1
			path: repo/tools/blockstate-upgrade-schema-utils.php

		-
			message: '#^Strict comparison using \!\=\= between null and null will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 1
			path: repo/tools/blockstate-upgrade-schema-utils.php

		-
			message: '#^Constant JSON_THROW_ON_ERROR is not allowed for parameter \#3 \$depth of function json_decode\.$#'
			identifier: argument.invalidConstant
			count: 1
			path: repo/tools/generate-item-upgrade-schema.php
