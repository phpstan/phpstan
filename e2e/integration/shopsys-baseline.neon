parameters:
	ignoreErrors:
		-
			message: '#^Call to method SplPriorityQueue\<mixed,mixed\>\:\:top\(\) on a separate line has no effect\.$#'
			identifier: method.resultUnused
			count: 1
			path: repo/packages/administration/src/Component/Crud/CrudControllerRegistry.php

		-
			message: '#^Function pg_query_split not found\.$#'
			identifier: function.notFound
			count: 1
			path: repo/packages/mcp/src/Component/Database/Query/PostgresQueryParser.php

		-
			message: '#^Strict comparison using \!\=\= between int\|string and false will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: repo/packages/migrations/src/Component/Doctrine/Migrations/MigrationsLockComparator.php
