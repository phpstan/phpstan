parameters:
	ignoreErrors:
		-
			rawMessage: 'Parameter #1 $min (0|1) of function random_int expects lower number than parameter #2 $max (int<0, 4>).'
			identifier: argument.type
			count: 1
			path: repo/src/Core/Framework/Demodata/Generator/ProductGenerator.php

		-
			rawMessage: 'Parameter #1 $email of method Shopware\Core\Framework\Sso\LoginResponseService::createErrorResponse() expects string, string|null given.'
			identifier: argument.type
			count: 1
			path: repo/src/Core/Framework/Sso/Controller/SsoController.php

		-
			rawMessage: 'Offset ''function'' on array{function: string, line?: int, file?: string, class?: class-string, type?: ''->''|''::'', args?: list<mixed>, object?: object} on left side of ?? always exists and is not nullable.'
			identifier: nullCoalesce.offset
			count: 1
			path: repo/tests/unit/Core/Profiling/Doctrine/BacktraceDebugDataHolderTest.php
