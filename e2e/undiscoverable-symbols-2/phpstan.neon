includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
parameters:
    level: max
    paths:
        - src
        - tests
    ignoreErrors:
        -
            rawMessage: 'Parameter #1 $key of static method MyCLabs\Enum\Enum<int>::isValidKey() expects string, int|string given.'
            identifier: argument.type
            path: src/Validator/EnumValidator.php
            reportUnmatched: false
