{
	"require": {
		"php": "^8.4",
		"bref/bref": "^3.0.14",
		"honeybadger-io/honeybadger-php": "^2.26",
		"jean85/pretty-package-versions": "^2.0.4",
		"nette/di": "^3.0",
		"nette/neon": "^3.3",
		"nikic/php-parser": "^5.1",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"sebastian/diff": "^9.0",
		"symfony/console": "^7.0"
	},
	"autoload": {
		"psr-4": {
			"PHPStanPlayground\\": "src/"
		}
	},
	"config": {
        "platform": {
            "php": "8.4.99"
        },
		"sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": false
		}
	}
}
