includes:
	- phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
	customRulesetUsed: true
	errorFormat: extractor
	paths:
		- repo/src
	ignoreErrors:
		# The restricted-usage rules run even with customRulesetUsed, so phpstan-src's own
		# runtime reflection calls (in its phpstan-baseline.neon) are reported here too.
		-
			identifier: phpstanApi.runtimeReflection
			reportUnmatched: false

rules:
	- IdentifierExtractor\Rule

services:
	errorFormatter.extractor:
		class: IdentifierExtractor\ErrorFormatter
		arguments:
			relativePathHelper: @simpleRelativePathHelper

	-
		class: IdentifierExtractor\RestrictedUsageCollector
		tags:
			- phpstan.collector

	-
		class: IdentifierExtractor\RuleErrorBuilderCollector
		tags:
			- phpstan.collector

	-
		class: IdentifierExtractor\ErrorWithIdentifierCollector
		tags:
			- phpstan.collector

	-
		class: IdentifierExtractor\RuleConstructorParameterCollector
		tags:
			- phpstan.collector
