---
pageType: blog
sectionTitle: Blog
---

{% extends "./_sidebar.njk" %}

{% block editPageLink %}{% endblock %}

{% block scripts %}
	<script src="/js/blog.ts" type="module"></script>
{% endblock %}

{% block postDate %}
	<p class="text-sm text-gray-500">{{ date | htmlDateString }} · {{ content | readingTime }}</p>
{% endblock %}

{% block socialImages %}
	{% if socialImage %}
		<meta name="twitter:image" content="https://phpstan.org{{ socialImage }}" />
		<meta property="og:image" content="https://phpstan.org{{ socialImage }}" />
	{% else %}
		{% socialImages title %}
	{% endif %}
{% endblock %}
