{% extends "./_base.njk" %}

{% block content %}

<div class="flex">
	<!-- ko with: mainMenu -->
		<div class="sidebar w-64 md:block hidden flex-none pr-4 border-r border-gray-200 fixed bg-white overflow-y-auto top-0 bottom-0 mt-16 pt-6 pl-4 md:pl-0 z-10 md:z-auto" data-bind="css: { hidden: !sidebarOpen() }, event: { click: handleSidebarClick }">
			{% if pageType === "documentation" %}
				<a href="/documentation" class="flex items-center px-3 py-1 text-sm text-gray-400 hover:text-gray-600 transition ease-in-out duration-150">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
					All Documentation
				</a>
			{% endif %}

			<div class="flex items-center {% if pageType === "documentation" %}mt-1{% endif %}">
				<span id="sectionTitle" class="group flex-grow items-center px-3 py-2 text-lg leading-5 font-bold text-gray-900">{{ sectionTitle }}</span>

				<span id="algoliaSectionTitle" class="hidden">{% block algoliaSectionTitle %}{{ sectionTitle }}{% endblock %}</span>

				<a href="#" class="md:hidden text-gray-400 hover:text-gray-500" data-bind="click: closeSidebar">
					<svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</a>
			</div>

			{% if sidebarGroups %}
				{% for group in sidebarGroups %}
					{% if group.label %}
						<div class="px-3 pt-5 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">{{ group.label }}</div>
					{% endif %}
					<ul>
						{% for item in group.items %}
							{% if item.link === page.filePathStem or item.link === (page.url | trimDotHtml) %}
								<li><a class="flex px-3 py-2 text-sm leading-5 font-medium rounded-md bg-blue-500 text-white" href="{{ item.link }}">{{ item.title }}</a></li>
							{% elif item.external %}
								<li><a target="_blank" class="flex items-center px-3 py-2 text-sm leading-5 font-medium rounded-md hover:bg-gray-50 transition ease-in-out duration-150" href="{{ item.link }}">
									<span>{{ item.title }}</span>
									<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" class="w-4 h-4 ml-1"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
								</a></li>
							{% else %}
								<li><a class="flex px-3 py-2 text-sm leading-5 font-medium rounded-md hover:bg-gray-50 transition ease-in-out duration-150" href="{{ item.link }}">{{ item.title }}</a></li>
							{% endif %}
						{% endfor %}
					</ul>
				{% endfor %}
			{% else %}
				<ul>
					{% for item in sidebarItems %}
						{% if item.link === page.filePathStem or item.link === (page.url | trimDotHtml) %}
							<li><a class="flex px-3 py-2 text-sm leading-5 font-medium rounded-md bg-blue-500 text-white" href="{{ item.link }}">{{ item.title }}</a></li>
						{% elif item.external %}
							<li><a target="_blank" class="flex items-center px-3 py-2 text-sm leading-5 font-medium rounded-md hover:bg-gray-50 transition ease-in-out duration-150" href="{{ item.link }}">
								<span>{{ item.title }}</span>
								<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" class="w-4 h-4 ml-1"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
							</a></li>
						{% else %}
							<li><a class="flex px-3 py-2 text-sm leading-5 font-medium rounded-md hover:bg-gray-50 transition ease-in-out duration-150" href="{{ item.link }}">{{ item.title }}</a></li>
						{% endif %}
					{% endfor %}
				</ul>
			{% endif %}

			<div class="mt-8 pt-6 border-t border-gray-200">
				<div class="px-3 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Other Sections</div>
				<ul>
					{% for item in sidebarOtherSections %}
						<li>
							<a href="{{ item.link }}" class="flex items-center px-3 py-2 text-sm leading-5 font-semibold text-gray-700 rounded-md hover:text-blue-600 hover:bg-blue-50 focus:outline-none focus:bg-blue-50 transition ease-in-out duration-150">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
								{{ item.title }}
							</a>
						</li>
					{% endfor %}
				</ul>
			</div>
			<div class="mt-8 rounded-lg bg-gradient-to-b from-blue-400 to-blue-700 to-80% text-white text-center font-semibold flex justify-center items-center text-2xl exclude-from-dark">
				<a class="px-3 py-3 md:py-10" href="/sponsor">Sponsor PHPStan!</a>
			</div>
		</div>
	<!-- /ko -->
	<div class="content px-4 pt-4 min-w-0 w-full ml-0 md:ml-64">
		<!-- ko with: mainMenu -->
			<a href="#" class="text-sm text-gray-400 md:hidden no-underline hover:underline" data-bind="click: openSidebar">Menu</a>
		<!-- /ko -->

		<div class="flex items-center justify-between gap-4 mb-4">
			{% block mainTitle %}<h1 class="leading-tight !mb-0">{{ title | fixTypos }}</h1>{% endblock %}
			{% block editPageLink %}
			<a href="https://github.com/phpstan/phpstan/edit/{{ git.branch }}/website/{{ page.inputPath | trimInputPath }}" class="flex-shrink-0 text-gray-300 hover:text-gray-500 transition duration-150" title="Edit this page on GitHub">
				<svg fill="currentColor" viewBox="0 0 20 20" class="w-5 h-5"><path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z"></path><path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd"></path></svg>
			</a>
			{% endblock %}
		</div>
		{% block postDate %}{% endblock %}

		{% block innerContent %}
			{{ content | safe }}
		{% endblock %}

		{% set nav = (page.url | trimDotHtml) | prevNextNav(sidebarGroups, sidebarItems) %}
		{% if nav.prev or nav.next %}
		<nav class="mt-12 pt-6 border-t border-gray-200 flex justify-between text-sm">
			<div>
				{% if nav.prev %}
				<a href="{{ nav.prev.link }}" class="text-gray-400 hover:text-gray-600 transition duration-150">
					&larr; Previous: {{ nav.prev.title }}
				</a>
				{% endif %}
			</div>
			<div>
				{% if nav.next %}
				<a href="{{ nav.next.link }}" class="text-gray-400 hover:text-gray-600 transition duration-150">
					Next: {{ nav.next.title }} &rarr;
				</a>
				{% endif %}
			</div>
		</nav>
		{% endif %}

		<div class="mt-16">
			{% include './../_includes/footer.njk' %}
		</div>
	</div>
</div>

{% endblock %}
