---
pagination:
  data: errorIdentifierGroups
  size: 1
  alias: group
permalink: "/error-identifiers/{{ group.prefix }}.html"
pageType: documentation
layout: null
eleventyComputed:
  title: "Error Identifiers: {{ group.prefix }}.*"
sectionTitle: User Guide
---

{% extends "../_layouts/_sidebar.njk" %}

{% block mainTitle %}{% endblock %}
{% block editPageLink %}{% endblock %}

{% block metaDescription %}
<meta name="description" content="All PHPStan error identifiers in the {{ group.prefix }}.* group. Browse {{ group.count }} error identifiers and learn how to fix them.">
{% endblock %}

{% block scripts %}
	<script src="/js/error-identifier-detail.ts" type="module"></script>
{% endblock %}

{% block innerContent %}

<p class="mb-4"><a href="/error-identifiers">&larr; Back to all error identifiers</a></p>

<h1 class="leading-tight">Error Identifiers: {{ group.prefix }}.*</h1>

<p>There {{ "is" if group.count === 1 else "are" }} {{ group.count }} error {{ "identifier" if group.count === 1 else "identifiers" }} in the <strong>{{ group.prefix }}.*</strong> group:</p>

<ul class="list-none pl-0 space-y-3">
{% for item in group.identifiers %}
	<li>
		<div>
			<a href="/error-identifiers/{{ item.identifier }}">{{ item.identifier }}</a>
			{% if item.label %}
				<span class="inline-block whitespace-nowrap text-xs bg-gray-400 text-white font-semibold rounded py-1 px-2">{{ item.label }}</span>
			{% endif %}
			{% if not item.ignorable %}
				<span class="inline-block whitespace-nowrap text-xs bg-red-500 text-white font-semibold rounded py-1 px-2">non-ignorable</span>
			{% endif %}
		</div>
		{% if item.shortDescription %}
			<div class="text-sm text-gray-500">{{ item.shortDescription }}</div>
		{% endif %}
	</li>
{% endfor %}
</ul>

{% endblock %}
