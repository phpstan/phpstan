	"license": "MIT",
	"dependencies": {
		"@bjorn3/browser_wasi_shim": "^0.4.2",
		"@codemirror/commands": "^6.2.2",
		"@codemirror/lang-php": "^6.0.1",
		"@codemirror/language": "^6.6.0",
		"@codemirror/lsp-client": "^6.2.4",
		"@codemirror/search": "^6.7.0",
		"@codemirror/state": "^6.2.0",
		"@codemirror/view": "^6.9.2",
		"@docsearch/js": "3",
		"@sentry/browser": "^7.52.1",
		"@stripe/stripe-js": "^4.9.0",
		"@tko/build.knockout": "^4.1.0",
		"jquery": "^3.6.0",
		"linkify-string": "^4.1.0",
		"linkifyjs": "^4.1.0",
		"littlefoot": "^4.1.4",
		"prism-themes": "^1.7.0",
		"prismjs": "^1.27.0",
		"process": "^0.11.10"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.2",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
		"@playwright/test": "^1.40.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@types/dompurify": "^3.0.0",
		"@types/jquery": "^3.5.5",
		"@types/lodash": "^4.14.188",
		"@types/prismjs": "^1.26.0",
		"@typescript-eslint/eslint-plugin": "^6.7.5",
		"@typescript-eslint/parser": "^6.7.5",
		"capture-website": "^3.2.0",
		"eslint": "^8.51.0",
		"glob": "^13.0.0",
		"headless-mermaid": "^1.3.0",
		"knockout": "^3.5.1",
		"luxon": "^3.0.0",
		"markdown-it": "^14.2.0",
		"markdown-it-abbr": "^2.0.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-attrs": "^4.5.0",
		"markdown-it-footnote": "^4.0.0",
		"npm-run-all2": "^8.0.4",
		"patch-package": "^8.0.1",
		"postcss": "^8.5.15",
		"postcss-modules": "^6.0.0",
		"reading-time": "^1.3.0",
		"serve": "^14.2.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.0.2",
		"typopo": "^3.0.2",
		"vite": "^7.3.1",
		"vite-plugin-static-copy": "^3.2.0"
	},
	"scripts": {
		"postinstall": "patch-package",
		"check": "tsc -p tsconfig.json --noEmit && eslint -c .eslintrc.js --ext .ts",
		"fix": "eslint -c .eslintrc.js --fix --ext .ts",
		"watch:vite": "vite --config vite.config.js",
		"watch:11ty": "eleventy --watch",
		"build:vite": "vite build --config vite.config.js",
		"build:11ty": "eleventy",
		"watch": "run-p watch:*",
		"build": "npm run build:11ty && npm run build:vite",
		"build:wasm": "bash scripts/build-wasm.sh",
		"build:stubs": "composer install --working-dir=scripts/stubs --no-interaction --quiet && php scripts/stubs/build-stubs.php",
		"test:visual": "playwright test --config=visual-tests/playwright.config.ts",
		"test:visual:update": "playwright test --config=visual-tests/playwright.config.ts --update-snapshots",
		"test:functional": "playwright test --config=functional-tests/playwright.config.ts"
	},
	"browserslist": [
		"defaults",
		"not IE 11"
	]
}
