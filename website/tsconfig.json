{
	"compilerOptions": {
		"target": "ES2020",
		"module": "esnext",
		"strict": true,
		"moduleResolution": "bundler",
		"lib": ["dom", "es2020"],
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noImplicitThis": true,
		"strictNullChecks": true,
		"noImplicitReturns": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": [
		"src/js/**/*"
	]
}
