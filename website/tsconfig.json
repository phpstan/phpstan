{
	"compilerOptions": {
		"target": "ES6",
		"module": "esnext",
		"strict": true,
		"moduleResolution": "bundler",
		"lib": ["dom", "es2019"],
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noImplicitThis": true,
		"strictNullChecks": true,
		"noImplicitReturns": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"jsx": "react",
		"jsxFactory": "ko.jsx.createElement",
		"jsxFragmentFactory": "ko.jsx.Fragment"
	},
	"include": [
		"src/js/**/*"
	]
}
